# Importer configuration. Rendered into a ConfigMap by kustomize.
#
# This is a flat KEY=VALUE file rather than a ConfigMap manifest for two reasons:
# kustomize's configMapGenerator hashes it into the ConfigMap name, so editing
# anything here rolls the pods automatically (environment is read once at
# startup, so a silent edit would otherwise do nothing until the next restart);
# and the Makefile can read a value out of it without parsing YAML.
#
# Full list of settings: README.md#configuration

# --- credentials -------------------------------------------------------
ECOBEE_TOKEN_STORE=kubernetes
# Propagated into the Role's resourceNames by a kustomize replacement, so this
# is the only place the Secret is named.
ECOBEE_SECRET_NAME=ecobee-importer-tokens
# ECOBEE_SECRET_NAMESPACE is intentionally absent: it defaults to the pod's own
# namespace. Set it only to read a Secret from a different namespace, which also
# requires promoting the Role in rbac.yaml to a ClusterRole.

# --- destination -------------------------------------------------------
# Cross-namespace, so the FQDN is required — the importer runs in its own
# namespace and a bare service name would not resolve.
#
# Common alternatives:
#   cluster VM   http://vminsert.<ns>.svc.cluster.local:8480/insert/0/prometheus/api/v1/import/prometheus
#   vmagent      http://vmagent.<ns>.svc.cluster.local:8429/api/v1/import/prometheus
ECOBEE_VM_IMPORT_URL=http://vmsingle-vmks-victoria-metrics-k8s-stack.monitoring.svc.cluster.local:8428/api/v1/import/prometheus
ECOBEE_WRITE_TIMEOUT_SECONDS=60
# For a destination behind authentication, mount a Secret and point at the file
# — the value never belongs in here:
# ECOBEE_VM_AUTH_HEADER_FILE=/etc/ecobee/vm-auth/authorization

# --- pacing ------------------------------------------------------------
# ecobee's documented floor is 900s. Lower values are clamped, not honoured.
ECOBEE_IMPORT_INTERVAL_SECONDS=900
# Re-imported on every restart. Idempotent, and it is what removes the need for
# any persisted watermark. Capped at the API's 31 days.
ECOBEE_STARTUP_LOOKBACK_HOURS=24
# Re-request this much before the watermark each cycle, so late-arriving and
# revised buckets are picked up.
ECOBEE_OVERLAP_MINUTES=60
ECOBEE_THERMOSTAT_CACHE_SECONDS=3600

# --- collection --------------------------------------------------------
ECOBEE_INCLUDE_SENSORS=true
# ECOBEE_EXTRA_COLUMNS adds to the default set; ECOBEE_COLUMNS replaces it
# entirely. Undocumented-unit columns (sky, wind, dmOffset) are excluded by
# default on purpose — verify what they mean before enabling them.
# ECOBEE_EXTRA_COLUMNS=sky,wind
# Static labels on every sample, for estates running more than one instance.
# ECOBEE_EXTRA_LABELS=site=kukui

# --- process -----------------------------------------------------------
# ECOBEE_METRICS_PORT is deliberately NOT set here. It would have to agree with
# containerPort in deployment.yaml, and a config file that can silently
# disagree with a manifest is the coupling this layout exists to remove. The
# application's default (9863) is what containerPort names.
ECOBEE_LOG_LEVEL=INFO
